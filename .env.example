# Copy this file to ".env" and fill in real values.
# Never commit the real .env file to git.

SECRET_KEY=replace-with-a-random-50-character-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Best-effort VPN/proxy/Tor detection. The visitor's public IP is sent to
# ipquery.io and the result is cached for 12 hours. Provider errors fail open.
VPN_DETECTION_ENABLED=True
# Keep True for stricter commercial-VPN detection. Set False if legitimate
# visitors on corporate/cloud networks are being blocked.
VPN_DETECTION_BLOCK_DATACENTER=True
VPN_DETECTION_API_URL=https://api.ipquery.io/{ip}
VPN_DETECTION_TIMEOUT_SECONDS=3
VPN_DETECTION_CACHE_SECONDS=43200
VPN_DETECTION_FAILURE_CACHE_SECONDS=300

# Leave the line below unset/commented to use SQLite (default, zero setup).
# To move to PostgreSQL later (after running pip install psycopg2-binary),
# uncomment and fill in:
# ACDZONE_DATABASE_URL=postgres://user:password@localhost:5432/acdzone

# Telegram support-chat bridge (optional — leave blank to skip it
# entirely, the on-site chat widget works fine without it).
# See the README's Telegram section for how to get these two values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=
